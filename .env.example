# Copy this file's contents into Netlify's Environment Variables UI
# (Site configuration → Environment variables) — Netlify Functions read
# process.env directly, there is no .env file loaded at runtime on Netlify.
# For local testing with the Netlify CLI, `netlify dev` reads a real
# .env file in this directory (gitignored) with the same variable names.

# ── Stripe — source of truth for tier pricing/availability ──────────────
# Test-mode keys (sk_test_… / whsec_… from a test-mode webhook) for a
# preview/staging site; live keys (sk_live_… / whsec_…) for production.
# Never mix a live secret key with test Product IDs or vice versa.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# One Stripe Product per tier. Whichever Product is `active` is the tier
# that's live for sale; tiers before it in this list are sold out, tiers
# after it aren't open yet (see netlify/functions/_shared/tiers.js).
STRIPE_PRODUCT_EARLY_BIRD=prod_...
STRIPE_PRODUCT_REGULAR=prod_...
STRIPE_PRODUCT_FINAL=prod_...

# ── Luma — event guests are added automatically on a paid order ─────────
LUMA_API_KEY=secret-...
LUMA_EVENT_ID=evt-...

# ── HitPay — PromptPay checkout. Price/availability are pulled live from
# Stripe above; HitPay itself never sets its own price. ──────────────────
# HITPAY_ENV=sandbox uses HitPay's sandbox API/dashboard (a fully separate
# business account with its own API key + webhook salt). Leave unset (or
# set to "live") for the production HitPay account.
#
# NOTE: HitPay's PromptPay method (opn_prompt_pay, routed through Opn/Omise)
# has NO sandbox simulation — "Sandbox Testing: ✕" per HitPay's own method
# table. create-promptpay-request.js / hitpay-webhook.js can still point at
# HITPAY_ENV=sandbox for API plumbing, but a payment request there can never
# actually reach status "completed". The PromptPay pipeline can only be
# verified end-to-end with one real, live, minimal-value payment (refund it
# afterward via the HitPay dashboard's Refund API).
HITPAY_ENV=sandbox
HITPAY_API_KEY=...
# Salt of the specific webhook endpoint registered under
# Developers → Webhooks in the HitPay dashboard (NOT the API-key salt
# shown next to the API key on the main Developers page).
HITPAY_WEBHOOK_SALT=...

# ── Optional: Meta Conversions API (server-side Purchase events) ────────
META_CAPI_ACCESS_TOKEN=
